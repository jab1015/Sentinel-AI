<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sentinel AI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#111827">

        <StackPanel Margin="30">

            <TextBlock
                Text="🛡 Sentinel AI"
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                Margin="0,8,0,30"
                Text="AI-Powered Windows Security"
                FontSize="18"
                Foreground="#9CA3AF"/>

            <Border
                Background="#1F2937"
                CornerRadius="10"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="System Status"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        x:Name="CpuText"
                        Margin="0,20,0,0"
                        Text="CPU Usage: Loading..."
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        x:Name="MemoryText"
                        Margin="0,10,0,0"
                        Text="Memory Usage: Loading..."
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        x:Name="DiskText"
                        Margin="0,10,0,0"
                        Text="Disk Usage: Loading..."
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        x:Name="NetworkText"
                        Margin="0,10,0,0"
                        Text="Network: Waiting..."
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        x:Name="LastUpdatedText"
                        Margin="0,20,0,0"
                        Text="Last Updated: --"
                        FontSize="14"
                        Foreground="#9CA3AF"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>
</Window>