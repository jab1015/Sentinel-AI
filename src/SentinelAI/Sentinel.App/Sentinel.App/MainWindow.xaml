<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sentinel AI">

    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid Background="#111827">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Sentinel AI dashboard">
            <StackPanel Margin="36" Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="Assets/Shield.png" Width="34" Height="34" Stretch="Uniform" AutomationProperties.Name="Sentinel AI shield"/>
                        <TextBlock Text="Sentinel AI" FontSize="30" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
                    </StackPanel>
                    <TextBlock Text="Your Windows Investigation Assistant" FontSize="16" Foreground="#9CA3AF"/>
                </StackPanel>

                <Border Background="#1F2937" CornerRadius="14" Padding="30">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="GreetingText" Text="Hello." FontSize="30" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock x:Name="OverallStatusText" Text="I’m analyzing your computer." FontSize="23" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="AttentionStatusText" Text="I’ll tell you only if something requires your attention." FontSize="17" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MonitoringStatusText" Text="I’ll continue monitoring your computer." FontSize="15" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <Button x:Name="GuidanceActionButton" Visibility="Collapsed" HorizontalAlignment="Left" Click="GuidanceActionButton_Click" AutomationProperties.Name="Perform recommended action"/>
                    </StackPanel>
                </Border>

                <Border Background="#1F2937" CornerRadius="14" Padding="26">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Ask Sentinel" FontSize="24" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="Ask a question about what Sentinel can currently verify on this computer." FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AskSentinelQuestionBox" PlaceholderText="For example: Why is my computer using so much memory?" AcceptsReturn="False" KeyDown="AskSentinelQuestionBox_KeyDown" AutomationProperties.Name="Ask Sentinel question" AutomationProperties.HelpText="Type a question about what Sentinel can verify on this computer."/>
                            <Button Grid.Column="1" x:Name="AskSentinelButton" Content="Ask" MinWidth="92" Click="AskSentinelButton_Click" AutomationProperties.Name="Ask Sentinel"/>
                        </Grid>
                        <TextBlock x:Name="AskSentinelStatusText" Text="Sentinel answers only from verified local evidence." FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Border x:Name="AskSentinelAnswerBorder" Background="#111827" CornerRadius="8" Padding="16" Visibility="Collapsed"><StackPanel Spacing="6"><TextBlock Text="Sentinel" FontSize="14" FontWeight="SemiBold" Foreground="#9CA3AF"/><TextBlock x:Name="AskSentinelAnswerText" FontSize="16" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
                    </StackPanel>
                </Border>

                <Border x:Name="IssueSummaryBorder" Background="#1F2937" CornerRadius="14" Padding="26" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Investigation Summary" FontSize="24" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/>
                        <StackPanel Spacing="5"><TextBlock Text="What I found" FontSize="14" Foreground="#9CA3AF"/><TextBlock x:Name="GuidanceTitleText" Text="Analyzing your computer" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3"/><TextBlock x:Name="GuidanceWhatHappenedText" FontSize="16" Foreground="#D1D5DB" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Why it matters" FontSize="14" Foreground="#9CA3AF"/><TextBlock x:Name="GuidanceWhyItMattersText" FontSize="16" Foreground="#D1D5DB" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="What I investigated" FontSize="14" Foreground="#9CA3AF"/><TextBlock x:Name="GuidanceEvidenceText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="What happens next" FontSize="14" Foreground="#9CA3AF"/><TextBlock x:Name="GuidanceActionText" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="GuidanceFixDetailsText" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"/></StackPanel>
                        <TextBlock x:Name="GuidanceFixAvailabilityText" FontSize="14" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        <Button x:Name="VerifyGuidanceButton" Content="Check Again" HorizontalAlignment="Left" Visibility="Collapsed" Click="VerifyGuidanceButton_Click" AutomationProperties.Name="Check investigation again"/>
                        <Border x:Name="VerificationResultBorder" Background="#111827" CornerRadius="8" Padding="14" Visibility="Collapsed"><StackPanel><TextBlock x:Name="VerificationResultTitleText" FontSize="16" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level3"/><TextBlock x:Name="VerificationResultMessageText" Margin="0,6,0,0" FontSize="14" Foreground="#D1D5DB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
                    </StackPanel>
                </Border>

                <Border x:Name="InvestigationHistoryBorder" Background="#1F2937" CornerRadius="14" Padding="26" Visibility="Collapsed">
                    <StackPanel Spacing="14"><TextBlock Text="Recent Investigations" FontSize="24" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="HistoryOutcomeIconText" Text="👁" FontSize="20" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="HistoryTitleText" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3"/><TextBlock x:Name="HistorySummaryText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/><TextBlock x:Name="HistoryOutcomeText" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"/></StackPanel></Grid></StackPanel>
                </Border>

                <Expander Header="Technical details" HorizontalAlignment="Stretch" AutomationProperties.Name="Technical details">
                    <StackPanel Spacing="12" Padding="0,14,0,0">
                        <Border Background="#1F2937" CornerRadius="10" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Executive Summary" FontSize="20" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/><TextBlock x:Name="RiskSummaryText" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="RecommendationText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/><TextBlock x:Name="RiskScoreText" Visibility="Collapsed"/><TextBlock x:Name="RiskLevelText" Visibility="Collapsed"/><TextBlock x:Name="GuidanceSeverityText" Visibility="Collapsed"/><TextBlock x:Name="GuidanceConfidenceText" Visibility="Collapsed"/><TextBlock x:Name="GuidanceConfidenceLabelText" Visibility="Collapsed"/></StackPanel></Border>
                        <Border Background="#1F2937" CornerRadius="10" Padding="20"><StackPanel Spacing="7"><TextBlock Text="System evidence" FontSize="20" FontWeight="SemiBold" Foreground="White" AutomationProperties.HeadingLevel="Level2"/><TextBlock x:Name="CpuText" Foreground="#D1D5DB"/><TextBlock x:Name="MemoryText" Foreground="#D1D5DB"/><TextBlock x:Name="DiskText" Foreground="#D1D5DB"/><TextBlock x:Name="NetworkText" Foreground="#D1D5DB"/><TextBlock x:Name="ProcessText" Foreground="#D1D5DB" TextWrapping="Wrap"/><TextBlock x:Name="SecurityText" Foreground="#D1D5DB"/><TextBlock x:Name="LastUpdatedText" Foreground="#9CA3AF"/></StackPanel></Border>
                        <Grid Visibility="Collapsed"><TextBlock x:Name="CriticalEventsText"/><TextBlock x:Name="ErrorEventsText"/><TextBlock x:Name="LatestEventSummaryText"/><TextBlock x:Name="LatestEventMessageText"/><TextBlock x:Name="RunningProcessesText"/><TextBlock x:Name="FlaggedProcessesText"/><TextBlock x:Name="PrimaryProcessText"/><TextBlock x:Name="PrimaryProcessReasonText"/><TextBlock x:Name="InstalledServicesText"/><TextBlock x:Name="RunningServicesText"/><TextBlock x:Name="FlaggedServicesText"/><TextBlock x:Name="PrimaryServiceText"/><TextBlock x:Name="PrimaryServiceReasonText"/></Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>