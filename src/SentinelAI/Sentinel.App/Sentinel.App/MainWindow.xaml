<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sentinel AI">

    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid Background="#111827">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock Text="🛡 Sentinel AI" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Your Windows Investigation Assistant" FontSize="16" Foreground="#9CA3AF"/>
                </StackPanel>

                <Border Background="#1F2937" CornerRadius="14" Padding="30">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="GreetingText" Text="Hello, Jerry." FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="OverallStatusText" Text="I’m analyzing your computer." FontSize="23" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AttentionStatusText" Text="I’ll tell you only if something requires your attention." FontSize="17" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MonitoringStatusText" Text="I’ll continue monitoring your computer." FontSize="15" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <Button x:Name="GuidanceActionButton" Visibility="Collapsed" HorizontalAlignment="Left" Click="GuidanceActionButton_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="IssueSummaryBorder" Background="#1F2937" CornerRadius="14" Padding="26" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Investigation Summary" FontSize="24" FontWeight="SemiBold" Foreground="White"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="What I found" FontSize="14" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="GuidanceTitleText" Text="Analyzing your computer" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GuidanceWhatHappenedText" FontSize="16" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Why it matters" FontSize="14" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="GuidanceWhyItMattersText" FontSize="16" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="What I investigated" FontSize="14" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="GuidanceEvidenceText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="What I need from you" FontSize="14" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="GuidanceActionText" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GuidanceFixDetailsText" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="GuidanceFixAvailabilityText" FontSize="14" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                        <Button x:Name="VerifyGuidanceButton" Content="Check Again" HorizontalAlignment="Left" Visibility="Collapsed" Click="VerifyGuidanceButton_Click"/>

                        <Border x:Name="VerificationResultBorder" Background="#111827" CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="VerificationResultTitleText" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="VerificationResultMessageText" Margin="0,6,0,0" FontSize="14" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="InvestigationHistoryBorder" Background="#1F2937" CornerRadius="14" Padding="26" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Recent Investigations" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HistoryOutcomeIconText" Text="👁" FontSize="20" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="HistoryTitleText" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HistorySummaryText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HistoryOutcomeText" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander Header="Technical details" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,14,0,0">
                        <Border Background="#1F2937" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Executive Summary" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="RiskSummaryText" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RecommendationText" FontSize="15" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RiskScoreText" Visibility="Collapsed"/>
                                <TextBlock x:Name="RiskLevelText" Visibility="Collapsed"/>
                                <TextBlock x:Name="GuidanceSeverityText" Visibility="Collapsed"/>
                                <TextBlock x:Name="GuidanceConfidenceText" Visibility="Collapsed"/>
                                <TextBlock x:Name="GuidanceConfidenceLabelText" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F2937" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="7">
                                <TextBlock Text="System evidence" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="CpuText" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="MemoryText" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="DiskText" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="NetworkText" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="ProcessText" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SecurityText" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="LastUpdatedText" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </Border>

                        <Grid Visibility="Collapsed">
                            <TextBlock x:Name="CriticalEventsText"/><TextBlock x:Name="ErrorEventsText"/>
                            <TextBlock x:Name="LatestEventSummaryText"/><TextBlock x:Name="LatestEventMessageText"/>
                            <TextBlock x:Name="RunningProcessesText"/><TextBlock x:Name="FlaggedProcessesText"/>
                            <TextBlock x:Name="PrimaryProcessText"/><TextBlock x:Name="PrimaryProcessReasonText"/>
                            <TextBlock x:Name="InstalledServicesText"/><TextBlock x:Name="RunningServicesText"/>
                            <TextBlock x:Name="FlaggedServicesText"/><TextBlock x:Name="PrimaryServiceText"/>
                            <TextBlock x:Name="PrimaryServiceReasonText"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>