<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.OptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sentinel AI Options">

    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid Background="#071426">
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2563EB"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,30" Spacing="22" MaxWidth="610" HorizontalAlignment="Center">
                <Border Background="#0B2545" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="28,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="Assets/Shield.png" Width="34" Height="34"/>
                        <StackPanel>
                            <TextBlock Text="Sentinel AI Options" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Control how Sentinel starts and runs on this computer." FontSize="14" Foreground="#BFDBFE"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Startup" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sentinel is added to startup by default so protection begins when you sign in. You can turn this off and restore it later." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Start Sentinel when I sign in" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ToggleSwitch x:Name="StartWithWindowsToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="StartWithWindowsToggle_Toggled"
                                              Foreground="White"
                                              AutomationProperties.Name="Start Sentinel when I sign in"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="StartupStatusText" Foreground="#BFDBFE" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Changes take effect immediately and are preserved during Sentinel updates." Foreground="#93C5FD" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
