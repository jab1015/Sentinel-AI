<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.OptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sentinel AI Options">

    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid Background="#071426">
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2563EB"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      Padding="0,0,8,0">
            <StackPanel Margin="34,30" Spacing="22" MaxWidth="610" HorizontalAlignment="Center">
                <Border Background="#0B2545" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="28,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="Assets/Shield.png" Width="34" Height="34"/>
                        <StackPanel>
                            <TextBlock Text="Sentinel AI Options" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Control Sentinel, your subscription, and how protection runs on this computer." FontSize="14" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Sentinel AI subscription" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Local security and system-health monitoring stays available without a subscription. An active subscription unlocks Ask Sentinel cloud investigations, automatic optimization, verified repairs, and containment or quarantine actions." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SubscriptionPlanText" Text="Checking Microsoft Store subscription…" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SubscriptionStatusText" Text="Sentinel is verifying your subscription." FontSize="14" Foreground="#BFDBFE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="MonthlySubscriptionButton" Content="Monthly" MinHeight="44" Click="MonthlySubscriptionButton_Click" IsEnabled="False"/>
                            <Button Grid.Column="1" x:Name="AnnualSubscriptionButton" Content="Annual — best value" MinHeight="44" Click="AnnualSubscriptionButton_Click" IsEnabled="False"/>
                        </Grid>
                        <Button x:Name="RefreshSubscriptionButton" Content="Refresh subscription" HorizontalAlignment="Left" Click="RefreshSubscriptionButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Startup" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sentinel is added to startup by default so protection begins when you sign in. You can turn this off and restore it later." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Start Sentinel when I sign in" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ToggleSwitch x:Name="StartWithWindowsToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="StartWithWindowsToggle_Toggled"
                                              Foreground="White"
                                              AutomationProperties.Name="Start Sentinel when I sign in"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="StartupStatusText" Foreground="#BFDBFE" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Computer optimization" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sentinel learns this computer's normal performance for free. Applying verified optimizations is a subscription feature." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Automatically optimize my computer" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ToggleSwitch x:Name="AutomaticOptimizationToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="OptimizationSetting_Changed"
                                              Foreground="White"
                                              AutomationProperties.Name="Automatically optimize my computer"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Optimization mode" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ComboBox x:Name="OptimizationModeComboBox"
                                          SelectionChanged="OptimizationModeComboBox_SelectionChanged"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Optimization mode">
                                    <ComboBoxItem Content="Conservative" Tag="Conservative"/>
                                    <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                    <ComboBoxItem Content="Advanced" Tag="Advanced"/>
                                </ComboBox>
                                <TextBlock Text="Conservative is the default and limits automatic changes to low-risk actions supported by verified local evidence." FontSize="13" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <CheckBox x:Name="VerifyEveryChangeCheckBox"
                                          IsEnabled="False"
                                          IsChecked="True">
                                    <TextBlock Text="Always verify every automatic optimization (required)"
                                               Foreground="#F3F4F6"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="RollbackCheckBox"
                                          IsEnabled="False"
                                          IsChecked="True">
                                    <TextBlock Text="Always roll back unsuccessful changes when possible (required)"
                                               Foreground="#F3F4F6"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="OptimizationStatusText" Foreground="#BFDBFE" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Changes take effect immediately and are preserved during Sentinel updates." Foreground="#93C5FD" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
