<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sentinel.App.OptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sentinel AI Options">

    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid Background="#071426">
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2563EB"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      Padding="0,0,8,0">
            <StackPanel Margin="34,30" Spacing="22" MaxWidth="610" HorizontalAlignment="Center">
                <Border Background="#0B2545" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="28,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="Assets/Shield.png" Width="34" Height="34"/>
                        <StackPanel>
                            <TextBlock Text="Sentinel AI Options" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Control Sentinel, your subscription, and how protection runs on this computer." FontSize="14" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Features" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="See what Sentinel can do and which capabilities are included without a subscription." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Included with Sentinel" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="• Microsoft Defender and Windows Firewall status" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• System-health and performance monitoring" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Local investigation summaries and recent activity" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• File and folder inspection from Windows Explorer" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Performance baseline learning" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Manual optimization scans" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Startup protection controls" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="9">
                                <TextBlock Text="With an active subscription" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="• Advanced Sentinel security monitoring and correlation" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Proactive investigations and Ask Sentinel cloud investigations" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Automatic computer optimization" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Verified repairs, containment, and quarantine" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Premium Privacy: Encrypt File and Sentinel Vault" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                <TextBlock Text="• Secure Delete and privacy-related artifact discovery" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Premium actions remain unavailable unless Sentinel can verify the required subscription entitlement." FontSize="13" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Sentinel AI subscription" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Basic Microsoft Defender, Windows Firewall, and system-health status stays available without a subscription. An active subscription unlocks advanced Sentinel security monitoring and correlation, proactive investigations, Ask Sentinel cloud investigations, automatic optimization, verified repairs, containment, and quarantine." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SubscriptionPlanText" Text="Checking Microsoft Store subscription…" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SubscriptionStatusText" Text="Sentinel is verifying your subscription." FontSize="14" Foreground="#BFDBFE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="MonthlySubscriptionButton" Content="Monthly" MinHeight="44" Click="MonthlySubscriptionButton_Click" IsEnabled="False"/>
                            <Button Grid.Column="1" x:Name="AnnualSubscriptionButton" Content="Annual — best value" MinHeight="44" Click="AnnualSubscriptionButton_Click" IsEnabled="False"/>
                        </Grid>
                        <Button x:Name="RefreshSubscriptionButton" Content="Refresh subscription" HorizontalAlignment="Left" Click="RefreshSubscriptionButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Startup" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sentinel is added to startup by default so protection begins when you sign in. You can turn this off and restore it later." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Start Sentinel when I sign in" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ToggleSwitch x:Name="StartWithWindowsToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="StartWithWindowsToggle_Toggled"
                                              Foreground="White"
                                              AutomationProperties.Name="Start Sentinel when I sign in"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="StartupStatusText" Foreground="#BFDBFE" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Computer optimization" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sentinel learns this computer's normal performance for free. You can run a manual scan at any time. Applying verified optimizations is a subscription feature." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Check my computer now" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Run a fresh optimization scan for peace of mind. The scan checks current performance against Sentinel's local baseline and never changes your computer." FontSize="13" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                                <Button x:Name="RunOptimizationScanButton"
                                        Content="Run optimization scan now"
                                        HorizontalAlignment="Left"
                                        MinHeight="42"
                                        Click="RunOptimizationScanButton_Click"
                                        AutomationProperties.Name="Run optimization scan now"/>
                                <TextBlock x:Name="ManualOptimizationScanStatusText"
                                           Foreground="#BFDBFE"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Automatically optimize my computer" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ToggleSwitch x:Name="AutomaticOptimizationToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="OptimizationSetting_Changed"
                                              Foreground="White"
                                              AutomationProperties.Name="Automatically optimize my computer"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Optimization mode" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <ComboBox x:Name="OptimizationModeComboBox"
                                          SelectionChanged="OptimizationModeComboBox_SelectionChanged"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Optimization mode">
                                    <ComboBoxItem Content="Conservative" Tag="Conservative"/>
                                    <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                    <ComboBoxItem Content="Advanced" Tag="Advanced"/>
                                </ComboBox>
                                <TextBlock Text="Conservative is the default and limits automatic changes to low-risk actions supported by verified local evidence." FontSize="13" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <CheckBox x:Name="VerifyEveryChangeCheckBox"
                                          IsEnabled="False"
                                          IsChecked="True">
                                    <TextBlock Text="Always verify every automatic optimization (required)"
                                               Foreground="#F3F4F6"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="RollbackCheckBox"
                                          IsEnabled="False"
                                          IsChecked="True">
                                    <TextBlock Text="Always roll back unsuccessful changes when possible (required)"
                                               Foreground="#F3F4F6"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A2038" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="OptimizationStatusText" Foreground="#BFDBFE" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#123252" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="26">
                    <StackPanel Spacing="16">
                        <TextBlock Text="About Sentinel AI" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Windows security, investigation, system-health, repair, optimization, and privacy assistance from Modern Methods." FontSize="15" Foreground="#E5E7EB" TextWrapping="Wrap"/>

                        <Border Background="#0A2038" CornerRadius="10" Padding="16">
                            <Grid RowSpacing="10" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" FontSize="14" FontWeight="SemiBold" Foreground="#BFDBFE"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersionText" Text="Loading…" FontSize="14" Foreground="White" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher" FontSize="14" FontWeight="SemiBold" Foreground="#BFDBFE"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Modern Methods" FontSize="14" Foreground="White" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Package" FontSize="14" FontWeight="SemiBold" Foreground="#BFDBFE"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutPackageText" Text="Loading…" FontSize="14" Foreground="White" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="License" FontSize="14" FontWeight="SemiBold" Foreground="#BFDBFE"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutLicenseText" Text="Checking subscription…" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="The installed package version shown here is the version Windows is actually running on this computer." FontSize="13" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Changes take effect immediately and are preserved during Sentinel updates." Foreground="#93C5FD" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
